{
  "name": "chococobot-v5",
  "version": "0.1.0",
  "private": true,
  "description": "DAVE-safe Discord bot with cleanup, voice TTS, mini games, and Groq AI usage monitoring.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "setup:logs": "tsx scripts/setupLoggingGuild.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "postinstall": "bash scripts/setup-python-tts.sh"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.11",
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.2.0",
    "groq-sdk": "^1.2.0",
    "nanoid": "^5.0.9",
    "opusscript": "^0.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
