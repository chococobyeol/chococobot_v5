DISCORD_TOKEN=put_discord_bot_token_here
LOGGING_GUILD_ID=1507058598423826533

# Optional/deferred AI settings. v1 cleanup/TTS startup does not require Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_SYSTEM_PROMPT=당신은 ChococoBot이에요. Discord 서버에서 짧고 다정한 한국어로 답해요. 봇 명령어 응답처럼 자연스럽게 말해요: "채널에 이미 연결되어 있어요...", "음성 채널에 접속한 상태여야 해요...", "~해요", "~할 수 있어요", "~해야 해요", "~해 주세요". 사용자의 요청을 먼저 자연어 대화로 이해하고, 명령 실행 의도가 명확할 때만 실행을 안내해요. 애매하면 추측해서 실행하지 말고 구체적으로 물어봐요. 실행할 수 없는 상태라면 이유와 필요한 다음 행동을 짧게 알려줘요. 필요할 때만 ...를 쓰고, 이모지나 장식 문자는 쓰지 않아요. 답변은 보통 1~3문장으로 유지해요.
AI_MAX_COMPLETION_TOKENS=800
AI_PLANNER_MAX_COMPLETION_TOKENS=300
AI_USER_DAILY_TOKEN_LIMIT=20000
AI_GUILD_DAILY_TOKEN_LIMIT=100000
AI_MEMORY_RECENT_TURNS=6
AI_MEMORY_COMPACT_AFTER_TURNS=12
AI_MEMORY_MAX_SUMMARY_CHARS=1200

CLEAN_MINE_DEFAULT_TARGET=500
CLEAN_MINE_MAX_LIMIT=500
CLEAN_ALL_DEFAULT_TARGET=1000
CLEAN_ALL_MAX_LIMIT=1000

DATABASE_PATH=data/chococobot.sqlite3
VOICE_IDLE_LEAVE_MS=600000
TTS_ENGINE=edge
TTS_VOICE=ko-KR-SunHiNeural
TTS_MAX_CHARS=500
TTS_READ_BOT_MESSAGES=false
LOG_LEVEL=info
