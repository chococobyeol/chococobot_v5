DISCORD_TOKEN=put_discord_bot_token_here
# Optional for legacy slash-command registration only; v1 prefix mode does not require it.
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
LOGGING_GUILD_ID=1507058598423826533

# Optional/deferred AI settings. v1 cleanup/TTS startup does not require Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_SYSTEM_PROMPT=You are ChococoBot, a concise and friendly Korean Discord assistant.
AI_MAX_COMPLETION_TOKENS=800
AI_USER_DAILY_TOKEN_LIMIT=20000
AI_GUILD_DAILY_TOKEN_LIMIT=100000

CLEAN_MINE_DEFAULT_TARGET=500
CLEAN_MINE_MAX_LIMIT=500
CLEAN_ALL_DEFAULT_TARGET=1000
CLEAN_ALL_MAX_LIMIT=1000

DATABASE_PATH=data/chococobot.sqlite3
VOICE_IDLE_LEAVE_MS=600000
TTS_ENGINE=edge
TTS_VOICE=ko-KR-SunHiNeural
TTS_MAX_CHARS=500
TTS_READ_BOT_MESSAGES=false
LOG_LEVEL=info
